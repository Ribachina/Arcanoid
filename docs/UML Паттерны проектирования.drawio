        <mxCell id="sXGLAvp6sEslcXUGc5ul-133" parent="sXGLAvp6sEslcXUGc5ul-132" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="+ Клонировать()" vertex="1">
